{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohp1x.github.io/privyx/schema.json",
  "$defs": {
    "AgentConfig": {
      "description": "How to launch a tool and point it at the local proxy; never a shell command.",
      "properties": {
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "provider": {
          "default": "generic",
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "upstream": {
          "default": "",
          "title": "Upstream",
          "type": "string"
        },
        "env_vars": {
          "items": {
            "type": "string"
          },
          "title": "Env Vars",
          "type": "array"
        },
        "endpoint_env": {
          "items": {
            "type": "string"
          },
          "title": "Endpoint Env",
          "type": "array"
        },
        "base_path": {
          "default": "",
          "title": "Base Path",
          "type": "string"
        },
        "extends": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extends"
        },
        "adapter": {
          "title": "Adapter",
          "anyOf": [
            {
              "default": "auto",
              "enum": [
                "auto",
                "env",
                "claude",
                "codex",
                "pi"
              ],
              "type": "string"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "env_from": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env From",
          "type": "object"
        },
        "budget": {
          "$ref": "#/$defs/BudgetConfig"
        },
        "presets": {
          "items": {
            "type": "string"
          },
          "title": "Presets",
          "type": "array"
        },
        "privyx": {
          "additionalProperties": true,
          "title": "Privyx",
          "type": "object"
        }
      },
      "title": "AgentConfig",
      "type": "object",
      "additionalProperties": false
    },
    "AnchorConfig": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "default": "hmac",
          "title": "Type",
          "anyOf": [
            {
              "enum": [
                "hmac",
                "pasp"
              ]
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "title": "AnchorConfig",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "hmac",
                  "pasp"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "type": true,
              "secret": {
                "default": "",
                "title": "Secret",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "AuditConfig": {
      "description": "PII-safe audit trail.\n\nEvents (session created, transform, restore, proxy request) are appended as\nJSON lines to ``path``.  The trail records counts and entity *types*, never\npayload content; see :mod:`privyx.observability.audit`.",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "anyOf": [
            {
              "default": true,
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "path": {
          "default": "~/.privyx/audit.log",
          "title": "Path",
          "type": "string"
        },
        "tap": {
          "title": "Tap",
          "anyOf": [
            {
              "default": false,
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "tap_dir": {
          "default": "~/.privyx/tap",
          "title": "Tap Dir",
          "type": "string"
        },
        "prices": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelPrice"
          },
          "title": "Prices",
          "type": "object"
        }
      },
      "title": "AuditConfig",
      "type": "object",
      "additionalProperties": false
    },
    "BudgetConfig": {
      "description": "Limits on one ``privyx run`` launch; unset means no limit.",
      "properties": {
        "max_turns": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "string",
                  "pattern": "\\$\\{"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Turns"
        },
        "max_tokens": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "string",
                  "pattern": "\\$\\{"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        }
      },
      "title": "BudgetConfig",
      "type": "object",
      "additionalProperties": false
    },
    "DetectorCacheConfig": {
      "description": "Configuration for turn/detection caching.\n\nCaches entity detections for previously seen text spans, avoiding\nredundant regex or NLP scans across conversation turns.",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "anyOf": [
            {
              "default": true,
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "max_size": {
          "title": "Max Size",
          "anyOf": [
            {
              "default": 10000,
              "type": "integer"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        }
      },
      "title": "DetectorCacheConfig",
      "type": "object",
      "additionalProperties": false
    },
    "DetectorConfig": {
      "additionalProperties": true,
      "description": "Detector selection and its rules.",
      "properties": {
        "type": {
          "default": "regex",
          "title": "Type",
          "anyOf": [
            {
              "enum": [
                "llm",
                "presidio",
                "regex",
                "yaml"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "underscore_separates_words": {
          "title": "Underscore Separates Words",
          "anyOf": [
            {
              "default": false,
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "cache": {
          "anyOf": [
            {
              "$ref": "#/$defs/DetectorCacheConfig"
            },
            {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "pattern": "\\$\\{"
                }
              ]
            }
          ],
          "title": "Cache"
        }
      },
      "title": "DetectorConfig",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "regex",
                  "yaml"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "type": true,
              "cache": true,
              "underscore_separates_words": true,
              "patterns": {
                "additionalProperties": {
                  "type": "string"
                },
                "title": "Patterns",
                "type": "object"
              },
              "terms": {
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "title": "Terms",
                "type": "object"
              },
              "merge_terms": {
                "title": "Merge Terms",
                "anyOf": [
                  {
                    "default": false,
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "pattern": "\\$\\{"
                  }
                ]
              },
              "term_variants": {
                "title": "Term Variants",
                "anyOf": [
                  {
                    "default": false,
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "pattern": "\\$\\{"
                  }
                ]
              },
              "context": {
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "title": "Context",
                "type": "object"
              },
              "enable": {
                "items": {
                  "type": "string"
                },
                "title": "Enable",
                "type": "array"
              },
              "disable": {
                "items": {
                  "type": "string"
                },
                "title": "Disable",
                "type": "array"
              },
              "entropy_threshold": {
                "title": "Entropy Threshold",
                "anyOf": [
                  {
                    "default": 3.0,
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "pattern": "\\$\\{"
                  }
                ]
              },
              "decode": {
                "title": "Decode",
                "anyOf": [
                  {
                    "default": false,
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "pattern": "\\$\\{"
                  }
                ]
              },
              "normalize": {
                "title": "Normalize",
                "anyOf": [
                  {
                    "default": false,
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "pattern": "\\$\\{"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "presidio"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": true,
              "cache": true,
              "underscore_separates_words": true,
              "language": {
                "default": "en",
                "title": "Language",
                "type": "string"
              },
              "model": {
                "default": "",
                "title": "Model",
                "type": "string"
              },
              "entities": {
                "items": {
                  "type": "string"
                },
                "title": "Entities",
                "type": "array"
              },
              "score_threshold": {
                "title": "Score Threshold",
                "anyOf": [
                  {
                    "default": 0.35,
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "pattern": "\\$\\{"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "llm"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": true,
              "cache": true,
              "underscore_separates_words": true,
              "llm_provider": {
                "default": "openai",
                "title": "Llm Provider",
                "type": "string"
              },
              "llm_model": {
                "default": "",
                "title": "Llm Model",
                "type": "string"
              },
              "llm_api_key": {
                "default": "",
                "title": "Llm Api Key",
                "type": "string"
              },
              "llm_instructions": {
                "default": "",
                "title": "Llm Instructions",
                "type": "string"
              },
              "llm_timeout": {
                "title": "Llm Timeout",
                "anyOf": [
                  {
                    "default": 30.0,
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "pattern": "\\$\\{"
                  }
                ]
              },
              "llm_max_chars": {
                "title": "Llm Max Chars",
                "anyOf": [
                  {
                    "default": 4000,
                    "exclusiveMinimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "pattern": "\\$\\{"
                  }
                ]
              },
              "llm_fallback_on_error": {
                "title": "Llm Fallback On Error",
                "anyOf": [
                  {
                    "default": false,
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "pattern": "\\$\\{"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "ModelPrice": {
      "description": "USD per million tokens; cache rates default to 0.1x and 1.25x of input.",
      "properties": {
        "input": {
          "title": "Input",
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "output": {
          "title": "Output",
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "cache_read": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "\\$\\{"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read"
        },
        "cache_write": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "\\$\\{"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "title": "ModelPrice",
      "type": "object",
      "additionalProperties": false
    },
    "OperatorConfig": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "default": "pseudonym",
          "title": "Type",
          "anyOf": [
            {
              "enum": [
                "encrypt",
                "faker",
                "fpe",
                "hash",
                "partial",
                "pseudonym",
                "redact"
              ]
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "title": "OperatorConfig",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "pseudonym",
                  "faker"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "type": true,
              "seed": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "\\$\\{"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Seed"
              },
              "locale": {
                "default": "",
                "title": "Locale",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "redact"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": true,
              "token": {
                "default": "[REDACTED]",
                "title": "Token",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "hash"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": true,
              "length": {
                "title": "Length",
                "anyOf": [
                  {
                    "default": 12,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "pattern": "\\$\\{"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "encrypt"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": true,
              "key": {
                "default": "",
                "title": "Key",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "partial"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "fpe"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": true,
              "seed": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "\\$\\{"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Seed"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "PathMappingConfig": {
      "description": "How the transparent proxy joins the upstream URL and a request path.\n\n``origin`` keeps only the upstream's ``scheme://host[:port]`` and appends\nthe request path.  ``prefix`` keeps the upstream's path as well and appends\nthe request path after ``strip_prefix``, so a router at\n``https://router.example.com/api/v1`` serves ``/v1/chat/completions`` at\n``/api/v1/chat/completions``.  ``privyx run`` strips the agent's\n``base_path``.  Requests outside ``strip_prefix`` are refused.",
      "properties": {
        "mode": {
          "title": "Mode",
          "anyOf": [
            {
              "default": "origin",
              "enum": [
                "origin",
                "prefix"
              ],
              "type": "string"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "strip_prefix": {
          "default": "",
          "title": "Strip Prefix",
          "type": "string"
        }
      },
      "title": "PathMappingConfig",
      "type": "object",
      "additionalProperties": false
    },
    "PluginsConfig": {
      "description": "Plugin loading.\n\nOpt-in: nothing is loaded unless ``paths`` or ``modules`` name something.\nEach path, a directory or a ``.py`` file, is imported and scanned for\nconcrete subclasses of the Privyx component base classes, which are\nregistered under their ``name`` and become selectable as a component\n``type``.  Each module, such as an installed package, is imported and its\n``setup(px)`` called.  Installed packages are never loaded on their own:\nthere is no entry-point discovery.  Set ``enabled: false`` to skip both.",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "anyOf": [
            {
              "default": true,
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "modules": {
          "items": {
            "type": "string"
          },
          "title": "Modules",
          "type": "array"
        }
      },
      "title": "PluginsConfig",
      "type": "object",
      "additionalProperties": false
    },
    "PolicyConfig": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "default": "default",
          "title": "Type",
          "anyOf": [
            {
              "enum": [
                "default",
                "strict"
              ]
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "title": "PolicyConfig",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "default"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "type": true
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "strict"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": true,
              "allowed": {
                "items": {
                  "type": "string"
                },
                "title": "Allowed",
                "type": "array"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "ProviderConfig": {
      "additionalProperties": true,
      "description": "Provider transport settings.\n\n``base_url`` defaults to empty rather than to a URL: an empty value lets\nthe provider registry fall back to the endpoint that provider type is\ndocumented to use (``api.openai.com`` for ``openai``, and so on).  A\nnon-empty default here would silently override every such fallback.",
      "properties": {
        "type": {
          "default": "generic",
          "title": "Type",
          "anyOf": [
            {
              "enum": [
                "anthropic",
                "generic",
                "google",
                "openai"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "base_url": {
          "default": "",
          "title": "Base Url",
          "type": "string"
        },
        "api_key": {
          "default": "",
          "title": "Api Key",
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        }
      },
      "title": "ProviderConfig",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "generic",
                  "openai",
                  "anthropic",
                  "google"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "type": true,
              "base_url": true,
              "api_key": true,
              "headers": true,
              "openai_api_key": {
                "default": "",
                "title": "Openai Api Key",
                "type": "string"
              },
              "anthropic_api_key": {
                "default": "",
                "title": "Anthropic Api Key",
                "type": "string"
              },
              "google_api_key": {
                "default": "",
                "title": "Google Api Key",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "ProxyConfig": {
      "description": "Proxy serving mode.\n\n``mode`` selects which app :command:`privyx proxy` serves:\n\n- ``gateway`` \u2014 configured routes sent to a fixed upstream endpoint;\n  embeddings and legacy completions use sibling endpoints. Native Ollama\n  and OpenAI/Anthropic token-counting or compaction routes are not served.\n  Gemini routes require the Google provider.\n- ``transparent`` \u2014 a drop-in reverse proxy.  Point a client's\n  ``OPENAI_BASE_URL`` / ``ANTHROPIC_BASE_URL`` at Privyx and every path is\n  forwarded to the upstream; configured masking routes are pseudonymized\n  on the way out and restored on the way back. ``path_mapping`` can keep\n  an upstream path prefix.\n\n``routes`` maps a request path to the wire schema used to transform it.\nIn transparent mode, paths not listed are forwarded verbatim when\n``passthrough_unknown`` is set (the default) and refused with 403 when it is\nnot.  The gateway serves only the listed paths either way.",
      "properties": {
        "mode": {
          "title": "Mode",
          "anyOf": [
            {
              "default": "transparent",
              "enum": [
                "gateway",
                "transparent"
              ],
              "type": "string"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "routes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Routes",
          "type": "object"
        },
        "path_mapping": {
          "$ref": "#/$defs/PathMappingConfig"
        },
        "forward_client_auth": {
          "title": "Forward Client Auth",
          "anyOf": [
            {
              "default": true,
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "passthrough_unknown": {
          "title": "Passthrough Unknown",
          "anyOf": [
            {
              "default": true,
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "timeout": {
          "title": "Timeout",
          "anyOf": [
            {
              "default": 300.0,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "connect_timeout": {
          "title": "Connect Timeout",
          "anyOf": [
            {
              "default": 10.0,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "max_connections": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "string",
                  "pattern": "\\$\\{"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Connections"
        },
        "dlp_check": {
          "title": "Dlp Check",
          "anyOf": [
            {
              "default": false,
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "directive": {
          "title": "Directive",
          "anyOf": [
            {
              "default": false,
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "cache_control": {
          "title": "Cache Control",
          "anyOf": [
            {
              "default": false,
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        }
      },
      "title": "ProxyConfig",
      "type": "object",
      "additionalProperties": false
    },
    "SessionConfig": {
      "description": "How a session is identified when the client sends no ``x-privyx-session``.\n\nAn explicit ``x-privyx-session`` header always wins.  Absent one, ``strategy``\ndecides the fallback:\n\n- ``ephemeral`` (default) \u2014 a fresh session per request.  Nothing is shared\n  between requests, so two callers' pseudonym maps can never collide, but a\n  multi-turn conversation is re-tokenized from scratch every turn and shows up\n  as many sessions.\n- ``client`` \u2014 a stable session derived from the client credential\n  (``Authorization`` / ``x-api-key``): one API key \u2192 one reused session.\n  Simple, but every conversation under that key shares one pseudonym map.\n- ``conversation`` \u2014 a stable session derived from the credential *and* the\n  first user message, so one conversation \u2192 one reused session while different\n  conversations (even under the same key) stay isolated.\n\nBoth derived strategies fall back to ``ephemeral`` when their signal is absent\n(e.g. a request carries no credential).",
      "properties": {
        "strategy": {
          "title": "Strategy",
          "anyOf": [
            {
              "default": "ephemeral",
              "enum": [
                "ephemeral",
                "client",
                "conversation"
              ],
              "type": "string"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        }
      },
      "title": "SessionConfig",
      "type": "object",
      "additionalProperties": false
    },
    "TLSConfig": {
      "description": "TLS/SSL server configuration for HTTPS termination.",
      "properties": {
        "certfile": {
          "default": "",
          "title": "Certfile",
          "type": "string"
        },
        "keyfile": {
          "default": "",
          "title": "Keyfile",
          "type": "string"
        },
        "keyfile_password": {
          "default": "",
          "title": "Keyfile Password",
          "type": "string"
        },
        "ca_certs": {
          "default": "",
          "title": "Ca Certs",
          "type": "string"
        }
      },
      "title": "TLSConfig",
      "type": "object",
      "additionalProperties": false
    },
    "TokenConfig": {
      "description": "How placeholder tokens are serialized in text.\n\n``format`` must contain ``{type}`` and ``{id}``; ``{namespace}`` is optional.\nAdjacent placeholders need a delimiter between them.  The default reproduces\nthe historical ``<PRIVYX_EMAIL_1>`` syntax; alternatives include\n``[[{namespace}:{type}:{id}]]`` and ``<{namespace}:{type}:{id}>``.",
      "properties": {
        "namespace": {
          "default": "PRIVYX",
          "title": "Namespace",
          "type": "string"
        },
        "format": {
          "default": "<{namespace}_{type}_{id}>",
          "title": "Format",
          "type": "string"
        },
        "compact": {
          "title": "Compact",
          "anyOf": [
            {
              "default": false,
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "id_length": {
          "title": "Id Length",
          "anyOf": [
            {
              "default": 16,
              "maximum": 64,
              "minimum": 6,
              "type": "integer"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        },
        "label_format": {
          "default": "",
          "title": "Label Format",
          "type": "string"
        }
      },
      "title": "TokenConfig",
      "type": "object",
      "additionalProperties": false
    },
    "TracingConfig": {
      "description": "OpenTelemetry spans per proxied request (``pip install 'privyx[otel]'``).\n\nThe exporter is configured by the standard ``OTEL_*`` environment variables.",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "anyOf": [
            {
              "default": false,
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "\\$\\{"
            }
          ]
        }
      },
      "title": "TracingConfig",
      "type": "object",
      "additionalProperties": false
    },
    "VaultConfig": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "default": "memory",
          "title": "Type",
          "anyOf": [
            {
              "enum": [
                "memory",
                "redis",
                "sqlite"
              ]
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "title": "VaultConfig",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "memory"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "type": true,
              "ttl": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "exclusiveMinimum": 0,
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "\\$\\{"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Ttl"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "sqlite"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": true,
              "ttl": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "exclusiveMinimum": 0,
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "\\$\\{"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Ttl"
              },
              "dsn": {
                "default": "sqlite+aiosqlite:///~/.privyx/privyx.db",
                "title": "Dsn",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "redis"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": true,
              "ttl": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "exclusiveMinimum": 0,
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "\\$\\{"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Ttl"
              },
              "redis_url": {
                "default": "redis://localhost:6379/0",
                "title": "Redis Url",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      ]
    }
  },
