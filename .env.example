# Privyx environment configuration (copy to .env and fill in)

# --- Upstream provider endpoints ---
# Generic passthrough target when running `privyx proxy`
PRIVYX_UPSTREAM_URL=http://localhost:20128

# Provider keys (used only when adapter needs direct SDK access)
PRIVYX_OPENAI_API_KEY=
PRIVYX_ANTHROPIC_API_KEY=
# Read, but the google provider is not implemented yet — setting this alone
# does not make `provider.type: google` work.
PRIVYX_GOOGLE_API_KEY=

# --- Vault backend ---
# memory | sqlite | redis
PRIVYX_VAULT=memory
PRIVYX_VAULT_DSN=sqlite+aiosqlite:///privyx.db
PRIVYX_REDIS_URL=redis://localhost:6379/0
# Expire a session after this many seconds without a request (unset: keep it
# until pruned).  Set one with the client or conversation strategy below.
PRIVYX_VAULT_TTL=

# --- Session ---
# How a session is identified when the client sends no x-privyx-session header:
#   ephemeral (default) — a fresh session per request
#   client              — one reused session per API key
#   conversation        — one reused session per conversation (first user message)
# `privyx run` defaults this to `conversation`.
PRIVYX_SESSION_STRATEGY=

# --- Security ---
# HMAC anchor secret.  Set this to make pseudonyms deterministic across
# sessions (the same value always gets the same pseudonym).  Leave empty to
# use per-session counters instead; an empty secret disables anchoring rather
# than anchoring with a guessable key.
# Generate one with: openssl rand -hex 32
PRIVYX_ANCHOR_SECRET=

# Encrypt operator key (required for `operator.type: encrypt`).  32-byte
# AES-256 key as 64 hex chars; the vault then stores ciphertext, not plaintext.
# Generate one with: openssl rand -hex 32
PRIVYX_ENCRYPT_KEY=

# --- Server ---
PRIVYX_HOST=127.0.0.1
PRIVYX_PORT=8000

# --- Observability ---
PRIVYX_LOG_LEVEL=info
PRIVYX_LOGGING=json
# Debug file incl. third-party logs; at debug it holds raw PII (created 0600).
# PRIVYX_LOG_FILE=privyx-debug.log

# PII-safe audit trail (entity types + counts, never content) as JSONL.
PRIVYX_AUDIT_ENABLED=true
PRIVYX_AUDIT_PATH=privyx-audit.log
