# Privyx environment
#
# Docker Compose reads this file as `.env`: copy it there, then uncomment what
# you need.  Every line is optional; docker-compose.yml and the image have a
# default for each.  Outside Docker, export the same variables in your shell:
# Privyx itself does not read a `.env` file.

# --- Provider ---
# Where requests go: the provider's origin.  docker-compose.yml defaults to
# https://api.openai.com.
# PRIVYX_UPSTREAM_URL=https://api.anthropic.com

# A key Privyx sends upstream in place of each client's own.  Unset, the
# transparent proxy relays the client's key.
# PRIVYX_API_KEY=

# Per-provider keys.  Each is used only when `provider.type` in a config file
# names that provider; it then wins over PRIVYX_API_KEY.
# PRIVYX_OPENAI_API_KEY=
# PRIVYX_ANTHROPIC_API_KEY=
# Read, but the google provider is not implemented yet: setting this alone
# does not make `provider.type: google` work.
# PRIVYX_GOOGLE_API_KEY=

# --- Vault ---
# memory | sqlite | redis.  docker-compose.yml defaults to redis, on its own
# Redis service.
# PRIVYX_VAULT=redis
# PRIVYX_REDIS_URL=redis://redis:6379/0
# PRIVYX_VAULT_DSN=sqlite+aiosqlite:////data/privyx.db
# Expire a session after this many seconds without a request (unset: keep it
# until pruned).  docker-compose.yml defaults to a week.
# PRIVYX_VAULT_TTL=604800

# --- Session ---
# How a session is identified when the client sends no x-privyx-session header:
#   ephemeral    - a fresh session per request (the default outside Docker Compose)
#   client       - one reused session per API key
#   conversation - one reused session per conversation (first user message);
#                  what docker-compose.yml and `privyx run` default to
# PRIVYX_SESSION_STRATEGY=conversation

# --- Security ---
# HMAC anchor secret.  Set this to make pseudonyms deterministic across
# sessions (the same value always gets the same pseudonym).  Unset, tokens are
# per-session counters; an empty secret disables anchoring rather than
# anchoring with a guessable key.
# Generate one with: openssl rand -hex 32
# PRIVYX_ANCHOR_SECRET=

# Encrypt operator key (required for `operator.type: encrypt`).  32-byte
# AES-256 key as 64 hex chars; the vault then stores ciphertext, not plaintext.
# Generate one with: openssl rand -hex 32
# PRIVYX_ENCRYPT_KEY=

# --- Server ---
# Host port docker-compose.yml publishes the proxy on, bound to 127.0.0.1.
# PORT=8000
# Outside Docker: the address and port the proxy listens on.  In a container
# the proxy must listen on 0.0.0.0, which the image and docker-compose.yml set.
# PRIVYX_HOST=127.0.0.1
# PRIVYX_PORT=8000

# --- Observability ---
# PRIVYX_LOG_LEVEL=info
# text | json
# PRIVYX_LOGGING=json
# Debug file incl. third-party logs; at debug it holds raw PII (created 0600).
# PRIVYX_LOG_FILE=privyx-debug.log

# PII-safe audit trail (entity types + counts, never content) as JSONL.  In
# Docker it defaults to /data/privyx-audit.log, on the data volume.
# PRIVYX_AUDIT_ENABLED=true
# PRIVYX_AUDIT_PATH=privyx-audit.log
